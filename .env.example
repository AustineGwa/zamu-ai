# Zamu environment variables for the mysql profile (staging and production).
# Local development needs none of these: with no profile set, Zamu runs on the in-memory h2 profile.
# Never commit real values; in production these come from the host's secret store.

SPRING_PROFILES_ACTIVE=mysql

# Public base URL (used in links in emails and webhook URLs)
ZAMU_BASE_URL=http://localhost:8080

# MySQL 8.4 LTS, utf8mb4. The connection is forced to UTC (NFR-18).
ZAMU_DB_URL=jdbc:mysql://localhost:3306/zamu?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
ZAMU_DB_USERNAME=zamu
ZAMU_DB_PASSWORD=zamu

# NFR-06: AES-256 key for secrets at rest, held outside the database. 32 random bytes, Base64.
#   openssl rand -base64 32
ZAMU_ENCRYPTION_KEY=
# HMAC key for hashing one-time login codes. 32 random bytes, Base64.
ZAMU_CODE_HASH_KEY=

# SMTP for login codes and weekly report emails (NOT-03). Defaults suit a real provider (port 587, auth,
# STARTTLS). For Mailpit from compose.yaml use: host localhost, port 1025, auth false, starttls false.
ZAMU_SMTP_HOST=
ZAMU_SMTP_PORT=587
ZAMU_SMTP_USERNAME=
ZAMU_SMTP_PASSWORD=
ZAMU_SMTP_AUTH=true
ZAMU_SMTP_STARTTLS=true

# Session cookie Secure flag (NFR-07). Keep true; browsers accept it on http://localhost too.
ZAMU_COOKIE_SECURE=true
ZAMU_MAIL_FROM=Zamu <no-reply@zamu.local>

# Background job runner on/off for this instance
ZAMU_JOBS_ENABLED=true

# Where website sign-ups are emailed (optional; they always appear under Sign-ups in the admin console)
ZAMU_LEADS_NOTIFY_EMAIL=

# First Zamu admin, created on startup only if no admin exists yet
ZAMU_BOOTSTRAP_ADMIN_EMAIL=
ZAMU_BOOTSTRAP_ADMIN_NAME=Zamu Admin

# WhatsApp Cloud API (one Meta app for all tenants). Webhook URL: ${ZAMU_BASE_URL}/webhooks/whatsapp
# App secret: Meta app > App settings > Basic. Verify token: any long random string; enter the same in Meta.
ZAMU_WHATSAPP_APP_SECRET=
ZAMU_WHATSAPP_VERIFY_TOKEN=

# AI answers (Spring AI). Claude is the default provider; ANTHROPIC_API_KEY is required with the mysql profile.
ANTHROPIC_API_KEY=
# anthropic | openai | none (offline stand-in: local and tests only; go-live refuses it)
ZAMU_AI_CHAT_PROVIDER=anthropic
ZAMU_AI_MODEL_SMALL=claude-haiku-5-5
ZAMU_AI_MODEL_LARGE=claude-sonnet-5-5
# Optional vector search: set to openai and give OPENAI_API_KEY. Keyword search works without it.
ZAMU_AI_EMBEDDING_PROVIDER=none
OPENAI_API_KEY=

# Google Calendar for bookings (BK-01). OAuth client of type Web application; redirect URI:
# ${ZAMU_BASE_URL}/admin/calendar/callback. Leave empty to book from opening hours only.
ZAMU_GOOGLE_CLIENT_ID=
ZAMU_GOOGLE_CLIENT_SECRET=

# Running cost on the admin Usage page (REP-03). Placeholders: check Meta's current Kenya rate card.
ZAMU_BILLING_USD_TO_KES=129.00
ZAMU_BILLING_WHATSAPP_MESSAGE_USD=0.0100
